{
  "manifest_version": 2,
  "name": "WebLibre Fast Scroll",
  "version": "0.1.0",
  "description": "Draggable fast-scroll thumb for long web pages; tap the extension action to toggle per site.",
  "browser_specific_settings": {
    "gecko": {
      "id": "weblibre-fast-scroll@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Toggle fast scrollbar for this site"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
